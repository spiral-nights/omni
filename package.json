{
  "name": "omni-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build && pnpm gleam:build",
    "gleam:build": "node scripts/gleam-build.mjs build && node scripts/build-bridge.mjs",
    "build:stale": "node scripts/autobuild.js",
    "dev": "pnpm --filter @omni/web dev",
    "test": "pnpm gleam:build && vitest run && pnpm gleam:test",
    "gleam:test": "node scripts/gleam-build.mjs test",
    "gleam:check": "node scripts/gleam-build.mjs check && node scripts/lint-gleam-architecture.mjs",
    "gleam:lint": "node scripts/lint-gleam-architecture.mjs",
    "typecheck": "pnpm -r run typecheck",
    "wit:types": "jco types packages/types/wit/omni.wit -o packages/types/src/wit",
    "gleam:bridge": "node scripts/build-bridge.mjs"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.41.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "fflate": "^0.8.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=11.0.1",
      "happy-dom": "^21.0.4",
      "vitest": "^4.1.12",
      "@vitest/mocker": "^4.1.12",
      "esbuild": "^0.25.0",
      "source-map-js": "^1.2.2",
      "tinypool": "^2.1.2",
      "vite": "^6.4.4",
      "zod": "^4.6.7"
    }
  }
}
