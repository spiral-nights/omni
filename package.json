      "minimatch": ">=11.0.1",
      "happy-dom": "^21.0.4",
      "vitest": "^4.1.12",
      "@vitest/mocker": "^4.1.12",
      "esbuild": "^0.25.0",
      "source-map-js": "^1.2.2",
      "tinypool": "^2.1.2",
      "vite": "^6.4.4",
      "zod": "^4.6.7"
