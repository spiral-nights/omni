{
  "$schema": "https://omni.run/schema/v1/manifest.json",
  "id": "org.omni.plugin.feed",
  "name": "Timeline Feed & Composer",
  "version": "1.0.0",
  "description": "Decentralized Nostr timeline feed, live note subscriptions, and cryptographic note composer",
  "author": {
    "name": "Omni Core Team",
    "pubkey": "3bf0c63fcb93463407af97a5e5ee64fa883d107ef9e558472c4eb9aaaefa459d"
  },
  "icon": "feed",
  "entry": "dist/index.js",
  "components": [
    {
      "id": "feed-dock-icon",
      "type": "icon",
      "title": "Feed",
      "slot": "dock"
    },
    {
      "id": "feed-main",
      "type": "main",
      "title": "Timeline Feed",
      "slot": "main"
    }
  ],
  "permissions": {
    "nostr": {
      "read": { "allKinds": true },
      "write": { "allKinds": true },
      "sign": true
    },
    "storage": {
      "quotaMb": 5
    }
  }
}
