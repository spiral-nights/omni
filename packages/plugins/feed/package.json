{
  "name": "@omni/plugin-feed",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "wit:gen": "wit-bindgen moonbit ../../types/wit/omni.wit --out-dir . --ignore-stub && moon fmt",
    "build": "wit-bindgen moonbit ../../types/wit/omni.wit --out-dir . --ignore-stub && moon fmt && moon build --target wasm --release && node scripts/bundle-wasm.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@omni/types": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.0"
  }
}
