import {
  "omni/plugin/gen/world/omni-plugin",
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportHandleAction:handle-action",
        "wasmExportHandleActionPostReturn:cabi_post_handle-action",
        "wasmExportInit:init",
        "wasmExportInitPostReturn:cabi_post_init",
      ],
    },
  },
)
