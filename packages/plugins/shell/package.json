{
  "name": "@omni/plugin-shell",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./classic": {
      "types": "./dist/shell.d.ts",
      "default": "./dist/shell.js"
    },
    "./panorama": {
      "types": "./dist/panorama-shell.d.ts",
      "default": "./dist/panorama-shell.js"
    },
    "./editorial": {
      "types": "./dist/editorial-shell.d.ts",
      "default": "./dist/editorial-shell.js"
    },
    "./registry": {
      "types": "./dist/shell-registry.d.ts",
      "default": "./dist/shell-registry.js"
    },
    "./base": {
      "types": "./dist/base-shell.d.ts",
      "default": "./dist/base-shell.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omni/core": "workspace:*",
    "@omni/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
