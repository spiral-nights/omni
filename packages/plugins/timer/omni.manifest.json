{
  "$schema": "https://omni.run/schema/v1/manifest.json",
  "id": "org.omni.plugins.timer",
  "name": "Focus Timer",
  "version": "1.0.0",
  "description": "Minimalist Pomodoro and focus timer with live reactive dock updates",
  "author": {
    "name": "Omni Team",
    "pubkey": "3bf0c63fcb93463407af97b5e0918838e6fb709e4693b0110d96049f1e70bcbc"
  },
  "icon": "clock",
  "entry": "dist/bundle.js",
  "components": [
    {
      "id": "timer-dock-icon",
      "type": "icon",
      "title": "Focus Timer",
      "slot": "dock",
      "defaultProps": { "minutes": 25 }
    },
    {
      "id": "timer-sidebar-widget",
      "type": "sidebar",
      "title": "Focus Timer (Pomodoro)",
      "slot": "sidebar"
    }
  ],
  "permissions": {
    "storage": {
      "quotaMb": 1
    }
  }
}
