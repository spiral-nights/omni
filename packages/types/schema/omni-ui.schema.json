{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni.org/schemas/v1/omni-ui.schema.json",
  "title": "Omni Declarative UI Schema",
  "description": "Standardized schema for Omni's declarative server-driven UI primitives, rendered via Light DOM Custom Elements (<omni-*>).",
  "$ref": "#/$defs/OmniComponentNode",
  "$defs": {
    "OmniComponentNode": {
      "description": "Any valid Omni UI primitive node.",
      "oneOf": [
        { "$ref": "#/$defs/OmniBoxPrimitive" },
        { "$ref": "#/$defs/OmniCardPrimitive" },
        { "$ref": "#/$defs/OmniDividerPrimitive" },
        { "$ref": "#/$defs/OmniSpacerPrimitive" },
        { "$ref": "#/$defs/OmniTextPrimitive" },
        { "$ref": "#/$defs/OmniBadgePrimitive" },
        { "$ref": "#/$defs/OmniMetricPrimitive" },
        { "$ref": "#/$defs/OmniIconPrimitive" },
        { "$ref": "#/$defs/OmniAvatarPrimitive" },
        { "$ref": "#/$defs/OmniButtonPrimitive" },
        { "$ref": "#/$defs/OmniIconButtonPrimitive" },
        { "$ref": "#/$defs/OmniInputPrimitive" },
        { "$ref": "#/$defs/OmniTextareaPrimitive" },
        { "$ref": "#/$defs/OmniTogglePrimitive" },
        { "$ref": "#/$defs/OmniSelectPrimitive" },
        { "$ref": "#/$defs/OmniTabsPrimitive" },
        { "$ref": "#/$defs/OmniStatusIndicatorPrimitive" },
        { "$ref": "#/$defs/OmniCodeBlockPrimitive" },
        { "$ref": "#/$defs/OmniProgressPrimitive" },
        { "$ref": "#/$defs/OmniBannerPrimitive" },
        { "$ref": "#/$defs/OmniListPrimitive" },
        { "$ref": "#/$defs/OmniListItemPrimitive" },
        { "$ref": "#/$defs/OmniEmptyStatePrimitive" },
        { "$ref": "#/$defs/OmniVirtualListPrimitive" }
      ]
    },
    "OmniPrimitiveBase": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Optional DOM identifier." },
        "key": { "type": "string", "description": "Optional reconciliation key for list morphing." },
        "visible": { "type": "boolean", "default": true, "description": "Controls conditional visibility." },
        "style": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": { "type": "string" } }
          ],
          "description": "Inline CSS styles string or property map."
        },
        "page": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/OmniPageDeclaration" }
          ],
          "description": "Logical page metadata for host back-button and history tracking."
        }
      }
    },
    "OmniPageDeclaration": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "Logical page ID (e.g., 'thread:123', 'profile')." },
        "title": { "type": "string", "description": "Human-readable page title for shell header." },
        "url": { "type": "string", "description": "Optional sub-route URL (e.g., '?view=thread&id=123')." },
        "state": { "type": "object", "description": "Serializable state snapshot for history navigation." }
      }
    },
    "OmniAction": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Action event identifier." },
        "payload": { "type": "object", "description": "Optional payload passed to omni:action handler." },
        "navigate": {
          "type": "object",
          "properties": {
            "pluginId": { "type": "string" },
            "view": { "type": "string" },
            "route": { "type": "string" },
            "page": { "type": "string" },
            "back": { "type": "boolean" }
          },
          "description": "Declarative shell navigation directive."
        }
      }
    },
    "OmniBoxPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "box" },
            "direction": { "type": "string", "enum": ["row", "column"], "default": "column" },
            "gap": { "type": "string", "enum": ["none", "xs", "sm", "md", "lg"] },
            "align": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
            "justify": { "type": "string", "enum": ["start", "center", "between", "end"] },
            "wrap": { "type": "boolean", "default": false },
            "padding": { "type": "string", "enum": ["none", "xs", "sm", "md", "lg"] },
            "action": { "$ref": "#/$defs/OmniAction" },
            "background": { "type": "string" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/OmniComponentNode" }
            }
          }
        }
      ]
    },
    "OmniCardPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "children"],
          "properties": {
            "type": { "const": "card" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "icon": { "type": "string" },
            "headerAction": { "$ref": "#/$defs/OmniComponentNode" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/OmniComponentNode" }
            },
            "footer": {
              "type": "array",
              "items": { "$ref": "#/$defs/OmniComponentNode" }
            },
            "action": { "$ref": "#/$defs/OmniAction" },
            "bannerBackground": { "type": "string" }
          }
        }
      ]
    },
    "OmniDividerPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "divider" },
            "orientation": { "type": "string", "enum": ["horizontal", "vertical"], "default": "horizontal" }
          }
        }
      ]
    },
    "OmniSpacerPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "spacer" },
            "size": { "type": "string", "enum": ["xs", "sm", "md", "lg", "xl"], "default": "md" }
          }
        }
      ]
    },
    "OmniTextPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "text" },
            "content": { "type": "string" },
            "variant": { "type": "string", "enum": ["title", "subtitle", "body", "caption", "mono"], "default": "body" },
            "tone": { "type": "string", "enum": ["primary", "secondary", "muted", "accent", "error", "success"], "default": "primary" },
            "truncate": { "type": "boolean", "default": false },
            "action": { "$ref": "#/$defs/OmniAction" },
            "showInlineImages": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "OmniBadgePrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "label"],
          "properties": {
            "type": { "const": "badge" },
            "label": { "type": "string" },
            "tone": { "type": "string", "enum": ["neutral", "success", "warning", "error", "accent"], "default": "neutral" },
            "variant": { "type": "string", "enum": ["solid", "subtle", "outline"], "default": "subtle" },
            "dot": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "OmniMetricPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "label", "value"],
          "properties": {
            "type": { "const": "metric" },
            "label": { "type": "string" },
            "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
            "subtext": { "type": "string" },
            "trend": { "type": "string", "enum": ["up", "down", "neutral"] }
          }
        }
      ]
    },
    "OmniIconPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "icon" },
            "name": { "type": "string" },
            "size": { "type": "number", "default": 20 }
          }
        }
      ]
    },
    "OmniAvatarPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "avatar" },
            "src": { "type": "string" },
            "pubkey": { "type": "string" },
            "name": { "type": "string" },
            "size": { "type": "string", "enum": ["xs", "sm", "md", "lg", "xl"], "default": "md" },
            "action": { "$ref": "#/$defs/OmniAction" }
          }
        }
      ]
    },
    "OmniButtonPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "label", "action"],
          "properties": {
            "type": { "const": "button" },
            "label": { "type": "string" },
            "action": { "$ref": "#/$defs/OmniAction" },
            "variant": { "type": "string", "enum": ["primary", "secondary", "ghost", "danger"], "default": "primary" },
            "size": { "type": "string", "enum": ["sm", "md", "lg"], "default": "md" },
            "icon": { "type": "string" },
            "iconPosition": { "type": "string", "enum": ["left", "right"], "default": "left" },
            "disabled": { "type": "boolean", "default": false },
            "loading": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "OmniIconButtonPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "icon", "action"],
          "properties": {
            "type": { "const": "icon-button" },
            "icon": { "type": "string" },
            "tooltip": { "type": "string" },
            "action": { "$ref": "#/$defs/OmniAction" },
            "variant": { "type": "string", "enum": ["ghost", "secondary", "danger"], "default": "ghost" },
            "size": { "type": "string", "enum": ["sm", "md"], "default": "md" },
            "disabled": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "OmniInputPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "input" },
            "name": { "type": "string" },
            "placeholder": { "type": "string" },
            "value": { "type": "string" },
            "inputType": { "type": "string", "enum": ["text", "number", "search", "url", "password", "file"], "default": "text" },
            "accept": { "type": "string" },
            "clearable": { "type": "boolean", "default": false },
            "prefixIcon": { "type": "string" },
            "actionOnEnter": { "$ref": "#/$defs/OmniAction" },
            "actionOnChange": { "$ref": "#/$defs/OmniAction" }
          }
        }
      ]
    },
    "OmniTextareaPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "textarea" },
            "name": { "type": "string" },
            "placeholder": { "type": "string" },
            "value": { "type": "string" },
            "rows": { "type": "number", "default": 3 }
          }
        }
      ]
    },
    "OmniTogglePrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "name", "checked", "action"],
          "properties": {
            "type": { "const": "toggle" },
            "name": { "type": "string" },
            "label": { "type": "string" },
            "checked": { "type": "boolean" },
            "action": { "$ref": "#/$defs/OmniAction" },
            "disabled": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "OmniSelectPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "name", "options"],
          "properties": {
            "type": { "const": "select" },
            "name": { "type": "string" },
            "value": { "type": "string" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            },
            "action": { "$ref": "#/$defs/OmniAction" }
          }
        }
      ]
    },
    "OmniTabsPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "tabs", "activeTab", "action"],
          "properties": {
            "type": { "const": "tabs" },
            "tabs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "icon": { "type": "string" },
                  "badge": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
                }
              }
            },
            "activeTab": { "type": "string" },
            "action": { "$ref": "#/$defs/OmniAction" }
          }
        }
      ]
    },
    "OmniStatusIndicatorPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "status"],
          "properties": {
            "type": { "const": "status-indicator" },
            "status": { "type": "string", "enum": ["online", "connecting", "offline", "error"] },
            "label": { "type": "string" },
            "pulse": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "OmniCodeBlockPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "code"],
          "properties": {
            "type": { "const": "code-block" },
            "code": { "type": "string" },
            "language": { "type": "string", "default": "plaintext" },
            "copyable": { "type": "boolean", "default": true }
          }
        }
      ]
    },
    "OmniProgressPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "progress" },
            "value": { "type": "number" },
            "max": { "type": "number", "default": 100 },
            "label": { "type": "string" },
            "variant": { "type": "string", "enum": ["bar", "spinner", "disk", "ring"], "default": "bar" },
            "size": { "type": "number", "description": "Diameter in pixels for disk/ring (e.g. 260)." },
            "color": { "type": "string", "description": "Fill or stroke color for disk/ring." },
            "showTicks": { "type": "boolean", "default": false, "description": "Clock rim ticks (0, 5, ..., 60m)." },
            "action": { "$ref": "#/$defs/OmniAction" }
          }
        }
      ]
    },
    "OmniBannerPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "message"],
          "properties": {
            "type": { "const": "banner" },
            "tone": { "type": "string", "enum": ["info", "success", "warning", "error"], "default": "info" },
            "title": { "type": "string" },
            "message": { "type": "string" },
            "icon": { "type": "string" },
            "action": { "$ref": "#/$defs/OmniAction" },
            "actionLabel": { "type": "string" },
            "dismissible": { "type": "boolean", "default": false },
            "onDismissAction": { "$ref": "#/$defs/OmniAction" }
          }
        }
      ]
    },
    "OmniListPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "list" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/OmniListItemPrimitive" }
            },
            "onScrollEndAction": { "$ref": "#/$defs/OmniAction" },
            "hasMore": { "type": "boolean", "default": false },
            "loadingMore": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "OmniListItemPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "title"],
          "properties": {
            "type": { "const": "list-item" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "meta": { "type": "string" },
            "icon": { "type": "string" },
            "avatarUrl": { "type": "string" },
            "avatarPubkey": { "type": "string" },
            "checked": { "type": "boolean" },
            "onCheckAction": { "$ref": "#/$defs/OmniAction" },
            "onClickAction": { "$ref": "#/$defs/OmniAction" },
            "actions": {
              "type": "array",
              "items": { "$ref": "#/$defs/OmniComponentNode" }
            }
          }
        }
      ]
    },
    "OmniEmptyStatePrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "title"],
          "properties": {
            "type": { "const": "empty-state" },
            "icon": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "action": { "$ref": "#/$defs/OmniAction" },
            "actionLabel": { "type": "string" }
          }
        }
      ]
    },
    "OmniVirtualListPrimitive": {
      "allOf": [
        { "$ref": "#/$defs/OmniPrimitiveBase" },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "virtual-list" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/OmniComponentNode" }
            },
            "itemHeight": { "type": "number", "default": 64 },
            "overscan": { "type": "number", "default": 5 },
            "maxHeight": { "type": "string", "default": "400px" }
          }
        }
      ]
    }
  }
}
