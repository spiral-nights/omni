{
  "name": "@omni/types",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema.json": "./schema/omni-ui.schema.json",
    "./omni.wit": "./wit/omni.wit",
    "./wit": "./dist/wit/omni.js"
  },
  "files": [
    "dist",
    "schema",
    "wit"
  ],
  "scripts": {
    "generate:wit": "jco types wit/omni.wit -o src/wit",
    "build": "jco types wit/omni.wit -o src/wit && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
