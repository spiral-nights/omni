package omni:plugin@0.1.0;

/// Host UI rendering interface provided by Omni
interface ui {
    /// Renders or updates the active declarative UI view.
    /// The `view` parameter is a JSON-serialized OmniComponentNode matching omni-ui.schema.json.
    render: func(view: string);

    /// Updates a specific companion component viewport (e.g., "widget", "dock", "main").
    render-component: func(component-id: string, view: string);
}

/// Host Nostr and protocol capabilities provided to the plugin
interface nostr {
    /// Queries local 0ms store and relays.
    /// `filter` is a JSON-serialized array of NostrFilter. Returns a JSON-serialized array of NostrEvent.
    fetch: func(filter: string) -> string;

    /// Signs and broadcasts an event to the user's connected relays and local cache.
    /// `draft` is a JSON-serialized Nostr draft. Returns JSON-serialized NostrPublishResult.
    publish: func(draft: string) -> string;

    /// Retrieves the current user's hex public key.
    get-public-key: func() -> string;
}

/// The Omni WebAssembly Component Model World
world omni-plugin {
    import ui;
    import nostr;

    /// Invoked when the plugin is mounted.
    /// Returns the initial UI view (JSON string), or an empty string if using `ui.render()`.
    export init: func() -> string;

    /// Invoked when the user interacts with a UI primitive (button click, toggle, form submit).
    /// `action` is the action name string (e.g., "increment", "add-task").
    /// `payload` is the JSON-serialized action payload including ambient form values.
    /// Returns an optional updated UI view (JSON string), or an empty string if no re-render.
    export handle-action: func(action: string, payload: string) -> string;
}
